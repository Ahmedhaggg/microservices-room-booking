{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "moduleNameMapper": {
    "^libs/common(|/.*)$": "<rootDir>/../../../libs/common/src/$1",
    "^libs/shared(|/.*)$": "<rootDir>/../../../libs/shared/src/$1"
  },
  "testTimeout": 120000,
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  }
}
