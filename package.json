{
  "name": "meeting-room-booking",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20 <23"
  },
  "scripts": {
    "build": "pnpm run build:user-service && pnpm run build:booking-service && pnpm run build:notification-service && pnpm run build:rooms-service",
    "build:user-service": "nest build user-service",
    "build:booking-service": "nest build booking-service",
    "build:notification-service": "nest build notification-service",
    "build:rooms-service": "nest build rooms-service",
    "db:generate:user-service": "drizzle-kit generate --config=apps/user-service/drizzle.config.ts",
    "db:generate:booking-service": "drizzle-kit generate --config=apps/booking-service/drizzle.config.ts",
    "db:generate:notification-service": "drizzle-kit generate --config=apps/notification-service/drizzle.config.ts",
    "db:generate:rooms-service": "drizzle-kit generate --config=apps/rooms-service/drizzle.config.ts",
    "db:generate:all": "pnpm run db:generate:user-service && pnpm run db:generate:booking-service && pnpm run db:generate:notification-service && pnpm run db:generate:rooms-service",
    "db:migrate:user-service": "ts-node -r tsconfig-paths/register apps/user-service/src/infrastructure/database/migrate.ts",
    "db:migrate:booking-service": "ts-node -r tsconfig-paths/register apps/booking-service/src/db/migrate.ts",
    "db:migrate:notification-service": "ts-node -r tsconfig-paths/register apps/notification-service/src/db/migrate.ts",
    "db:migrate:rooms-service": "ts-node -r tsconfig-paths/register apps/rooms-service/src/db/migrate.ts",
    "db:migrate:all": "pnpm run db:migrate:user-service && pnpm run db:migrate:booking-service && pnpm run db:migrate:notification-service && pnpm run db:migrate:rooms-service",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start": "nest start user-service",
    "start:user-service": "nest start user-service",
    "start:booking-service": "nest start booking-service",
    "start:notification-service": "nest start notification-service",
    "start:rooms-service": "nest start rooms-service",
    "start:dev": "nest start user-service --watch",
    "start:dev:user-service": "nest start user-service --watch",
    "start:dev:booking-service": "nest start booking-service --watch",
    "start:dev:notification-service": "nest start notification-service --watch",
    "start:dev:rooms-service": "nest start rooms-service --watch",
    "start:debug": "nest start user-service --debug --watch",
    "start:prod": "node dist/apps/user-service/main",
    "start:prod:user-service": "node dist/apps/user-service/main",
    "start:prod:booking-service": "node dist/apps/booking-service/main",
    "start:prod:notification-service": "node dist/apps/notification-service/main",
    "start:prod:rooms-service": "node dist/apps/rooms-service/main",
    "lint": "eslint \"{src,apps,libs}/**/*.ts\" --fix"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/microservices": "^11.1.26",
    "@nestjs/platform-express": "^11.0.1",
    "amqp-connection-manager": "^5.0.0",
    "amqplib": "^0.10.9",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.44.5",
    "nestjs-zod": "^5.4.0",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@types/amqplib": "^0.10.7",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.15.5",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "testcontainers": "^11.13.0",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}
