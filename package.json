{
  "name": "meeting-room-booking",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "pnpm run build:auth-service && pnpm run build:booking-service && pnpm run build:notification-service && pnpm run build:rooms-service",
    "build:auth-service": "nest build auth-service",
    "build:booking-service": "nest build booking-service",
    "build:notification-service": "nest build notification-service",
    "build:rooms-service": "nest build rooms-service",
    "db:generate:auth-service": "drizzle-kit generate --config=apps/auth-service/drizzle.config.ts",
    "db:generate:booking-service": "drizzle-kit generate --config=apps/booking-service/drizzle.config.ts",
    "db:generate:notification-service": "drizzle-kit generate --config=apps/notification-service/drizzle.config.ts",
    "db:generate:rooms-service": "drizzle-kit generate --config=apps/rooms-service/drizzle.config.ts",
    "db:generate:all": "pnpm run db:generate:auth-service && pnpm run db:generate:booking-service && pnpm run db:generate:notification-service && pnpm run db:generate:rooms-service",
    "db:migrate:auth-service": "ts-node -r tsconfig-paths/register apps/auth-service/src/db/migrate.ts",
    "db:migrate:booking-service": "ts-node -r tsconfig-paths/register apps/booking-service/src/db/migrate.ts",
    "db:migrate:notification-service": "ts-node -r tsconfig-paths/register apps/notification-service/src/db/migrate.ts",
    "db:migrate:rooms-service": "ts-node -r tsconfig-paths/register apps/rooms-service/src/db/migrate.ts",
    "db:migrate:all": "pnpm run db:migrate:auth-service && pnpm run db:migrate:booking-service && pnpm run db:migrate:notification-service && pnpm run db:migrate:rooms-service",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start": "nest start auth-service",
    "start:auth-service": "nest start auth-service",
    "start:booking-service": "nest start booking-service",
    "start:notification-service": "nest start notification-service",
    "start:rooms-service": "nest start rooms-service",
    "start:dev": "nest start auth-service --watch",
    "start:dev:auth-service": "nest start auth-service --watch",
    "start:dev:booking-service": "nest start booking-service --watch",
    "start:dev:notification-service": "nest start notification-service --watch",
    "start:dev:rooms-service": "nest start rooms-service --watch",
    "start:debug": "nest start auth-service --debug --watch",
    "start:prod": "node dist/apps/auth-service/main",
    "start:prod:auth-service": "node dist/apps/auth-service/main",
    "start:prod:booking-service": "node dist/apps/booking-service/main",
    "start:prod:notification-service": "node dist/apps/notification-service/main",
    "start:prod:rooms-service": "node dist/apps/rooms-service/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "pnpm run test:e2e:auth-service && pnpm run test:e2e:booking-service && pnpm run test:e2e:notification-service && pnpm run test:e2e:rooms-service",
    "test:e2e:auth-service": "jest --config ./apps/auth-service/test/jest-e2e.json",
    "test:e2e:booking-service": "jest --config ./apps/booking-service/test/jest-e2e.json",
    "test:e2e:notification-service": "jest --config ./apps/notification-service/test/jest-e2e.json",
    "test:e2e:rooms-service": "jest --config ./apps/rooms-service/test/jest-e2e.json"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.44.5",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.2",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "testcontainers": "^11.13.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/apps/",
      "<rootDir>/libs/"
    ],
    "moduleNameMapper": {
      "^libs/common(|/.*)$": "<rootDir>/libs/common/src/$1",
      "^libs/shared(|/.*)$": "<rootDir>/libs/shared/src/$1"
    }
  }
}
